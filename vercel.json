{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/projects", "destination": "/index.html" },
    { "source": "/open-source", "destination": "/index.html" },
    { "source": "/certifications", "destination": "/index.html" },
